# Backend Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY backend/package*.json ./backend/

WORKDIR /app/backend

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY backend/ ./backend/

# Create logs directory
RUN mkdir -p /app/logs

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node /app/backend/server.js --health || exit 1

# Start application
CMD ["npm", "start"]
