# Example production environment variables

# App
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://yourdomain.com

# JWT
JWT_SECRET=change-me-super-secret
JWT_REFRESH_SECRET=change-me-super-refresh-secret

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=change-me

# AI Service
AI_SERVICE_API_KEY=change-me

