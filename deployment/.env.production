# Production Environment Configuration
# Copy this file to .env and configure for production deployment

# =====================================================
# SERVER CONFIGURATION
# =====================================================
NODE_ENV=production
PORT=5000
API_VERSION=v1

# =====================================================
# DATABASE CONFIGURATION (MongoDB)
# =====================================================
MONGODB_URI=mongodb://admin:password@mongodb:27017/fraud_detection?authSource=admin
MONGO_USER=admin
MONGO_PASSWORD=change_this_password_in_production

# =====================================================
# REDIS CONFIGURATION
# =====================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_password_in_production
REDIS_DB=0

# =====================================================
# JWT AUTHENTICATION
# =====================================================
JWT_SECRET=change_this_to_random_secure_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_random_secure_string
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# =====================================================
# EMAIL CONFIGURATION (SMTP)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=FraudShield <noreply@yourdomain.com>

# =====================================================
# AI MICROSERVICE CONFIGURATION
# =====================================================
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=change_this_to_secure_api_key

# =====================================================
# FRONTEND URL (for email links)
# =====================================================
FRONTEND_URL=https://yourdomain.com

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# SECURITY
# =====================================================
BCRYPT_ROUND=12
CORS_ORIGIN=https://yourdomain.com
